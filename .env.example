# YouTube topics + original scripts; independent fact checking is disabled.
CONTENT_MODE=youtube_insights
YOUTUBE_DISCOVERY_REGION=IN
# Optional legacy mode: CONTENT_MODE=verified_news enables RSS/Google Trends + evidence checks.
TIMEZONE=Asia/Kolkata
SCHEDULE_TIMES=09:30,11:18,13:06,14:54,16:42,18:30
# Prepare scripts once at 05:00, then create videos at the slots above.
DAILY_SCRIPT_BATCH=false
MORNING_PLAN_TIME=05:00
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional hosted generation and auditing. Uses your provider account's quotas.
# Groq mode uses lexical evidence ranking and does not load a local LLM.
LLM_PROVIDER=ollama
GEMINI_API_KEY=
RESEARCH_TIMEOUT_SECONDS=240
GEMINI_THINKING_LEVEL=low
LLM_REQUEST_TIMEOUT_SECONDS=60
SOURCE_REVIEW_TIMEOUT_SECONDS=25
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=all-minilm:22m
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_GENERATION_TIMEOUT_SECONDS=600
TTS_ENGINE=gemini
# For the hosted Indian male voice: TTS_ENGINE=gemini and TTS_VOICE=Puck.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Puck
TTS_SPEED=1.0
NARRATION_LANGUAGE=en
# For conversational Hindi with familiar English tech terms: hi + hinglish.
SCRIPT_STYLE=standard
KOKORO_MODEL=data/models/kokoro/kokoro-v1.0.int8.onnx
KOKORO_VOICES=data/models/kokoro/voices-v1.0.bin
# Optional CPU fallback on Windows: TTS_ENGINE=sapi
PEXELS_API_KEY=
PIXABAY_API_KEY=
YOUTUBE_CHANNEL_ID=''
YOUTUBE_CLIENT_SECRETS_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
YOUTUBE_MADE_FOR_KIDS=false
# public publishes future jobs after validation; private keeps them for review.
YOUTUBE_PRIVACY=private
ENABLE_UPLOAD=false
FFMPEG=ffmpeg
FFPROBE=ffprobe
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_DURATION_SECONDS=45
DURATION_MIN=35
DURATION_MAX=55
ENCODER_PRESET=fast
CRF=20
# Optional local Remotion renderer. Run scripts/setup_motion.ps1 first.
RENDER_MODE=hybrid
RENDER_FALLBACK=true
# Local creative enhancements; dashboard Video style switches override these for new runs.
MOTION_ICONS=true
MOTION_LOTTIE=true
SOUND_EFFECTS=true
CREATIVE_MANIFEST=data/creative/manifest.json
REMOTION_NODE=node
REMOTION_CONCURRENCY=1
REMOTION_TIMEOUT_SECONDS=1800
MAX_VIDEOS_PER_DAY=6
TOPIC_DEDUP_DAYS=14
PREFER_TECH_INSIGHTS=true
TOPIC_FOCUS=ai_coding
RESEARCH_CANDIDATE_LIMIT=40
ENABLE_EVERGREEN_FALLBACK=true
# Editorial inspiration only. Creator titles never replace verified evidence.
EDITORIAL_REFERENCES=[]
# Exact YouTube channel IDs, resolved from the intended creator links.
CREATOR_CHANNEL_IDS=["UCsQoiOrh7jzKmE8NBofhTnQ","UCoch_d78Aosmp14ey1HgGSQ","UCA295QVkf9O1RQ8_-s3FVXg"]
# Keyless Wikimedia Commons CC0/public-domain photos; original graphics remain a fallback.
ENABLE_PUBLIC_IMAGES=false
MIN_FREE_GB=2
RETENTION_DAYS=14
OUTPUT_DIR=output/jobs
CACHE_DIR=data/cache
DATABASE_PATH=data/database/autoyt.db
GOOGLE_TRENDS_REGION=IN
# JSON array overrides default feeds; use only permitted public feeds.
# RSS_FEEDS=["https://blog.google/rss/","https://blogs.microsoft.com/feed/","https://www.theverge.com/rss/index.xml"]

# Optional local Hinglish voice engine (see SETUP.md before selecting indicf5)
INDICF5_STEPS=16
INDICF5_TIMEOUT_SECONDS=3600

# CPU inference threads: tune for your hardware; more is not always faster.
INDICF5_THREADS=2
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
YOUTUBE_CHANNEL_ID=''

# Optional hosted voice provider; obtain voice IDs from the voice settings dropdown.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# OpenRouter scripts: free-only model, no paid fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Extra technology topic leads from public Google News RSS; no API key needed.
GOOGLE_NEWS_ENABLED=true

# CPU local scripting; optional second model: qwen3:8b
OLLAMA_RESEARCH_TIMEOUT_SECONDS=1800
